# ==============================================================================
# OPLINK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local and populate with your credentials
# ==============================================================================

# 1. MongoDB Atlas Connection URI (Direct Replica Set or Atlas SRV)
MONGODB_URI=
MONGODB_DB=oplink

# 2. JWT Session Encryption Key (Minimum 32 random characters in production)
JWT_SECRET=

# 3. Nebius Token Factory (120B Model Inference)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=openai/gpt-oss-120b

# 4. Crustdata API for Real Company Intelligence
CRUSTDATA_API_KEY=

# 5. neatlogs Telemetry Instrumentation
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=oplink-prod-2026

# 6. AWS Configuration (Optional Cloud Deployment)
AWS_REGION=us-east-1
